{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webnovel Hub",
  "version": "../package.json",
  "identifier": "io.github.ismaeldlr.webnovelhub",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../.. run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Webnovel Hub",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ismael de la Rosa",
    "shortDescription": "Read web novels from many sites in one library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NjcwNTgxNDFGQ0MyRDEKUldUUnd2eEJnUVZuaGErSWIzVTZBUTJHc3RrclNOWmd4RTNxYk8rSm5rbHZaNDVtdkUxV2xuNnMK",
      "endpoints": [
        "https://github.com/Ismaeldlr/WebNovel_Hub/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
