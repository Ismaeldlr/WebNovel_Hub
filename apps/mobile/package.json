{
  "name": "@webnovel-hub/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Webnovel Hub for Android: the web app in a Capacitor WebView.",
  "scripts": {
    "sync": "npm --prefix ../.. run build && cap sync android && npm run runner",
    "runner": "vite build --config runner/vite.config.ts",
    "open": "cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@webnovel-hub/core": "^0.0.0",
    "vite": "^8.3.1",
    "whatwg-url": "^16.0.1",
    "@types/node": "^22.20.4"
  }
}
