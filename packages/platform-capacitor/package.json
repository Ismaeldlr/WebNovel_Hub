{
  "name": "@webnovel-hub/platform-capacitor",
  "version": "0.0.0",
  "private": true,
  "description": "Runs Webnovel Hub's core in the Android app: SQLite, HTTP and the rest through Capacitor.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@webnovel-hub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@webnovel-hub/core": "^0.0.0",
    "@webnovel-hub/shared": "^0.0.0"
  }
}
