# Optional settings for development; the apps themselves need none.
# Copy this file to `.env` at the repository root. Vite reads the VITE_* variables.

# Where the browser build finds the development bridge that `npm run dev` starts. The
# bridge itself listens on WNH_BRIDGE_PORT (default 5174) and keeps its database in
# WNH_DEV_DB (default data/dev.db); set those in the shell that runs it.
VITE_BRIDGE_URL=http://127.0.0.1:5174
